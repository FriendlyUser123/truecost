# ─── Ready environment ──────────────────────────────────────────────────────
# EVERY key below is optional. With none of them set the app runs in DEMO MODE
# against seeded fixtures and a local simulated Nessie ledger. `npm run dev`
# works offline with this file absent.
#
# This file used to advertise MongoDB Atlas, Google Gemini and ElevenLabs.
# None of the three was ever connected — docs/FACTS.md lists all three under
# DO-NOT-CLAIM — and the code paths are gone, so the keys are gone with them.
# Nessie is the only external service this build actually talks to.

# Capital One Nessie (http://api.nessieisreal.com) — get one at nessieisreal.com
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=
# Printed by `npm run seed:nessie`. Needed only for the live write path.
NESSIE_CHECKING_ID=
NESSIE_PAYEE_ID=

# The median household on /average-american is a SECOND Nessie customer.
# Printed by `npm run seed:nessie:household`. Leave these empty and the page
# runs on its seeded ledger and says "Nessie seeded" rather than claiming live.
NESSIE_HOUSEHOLD_CUSTOMER_ID=
NESSIE_HOUSEHOLD_CHECKING_ID=
NESSIE_HOUSEHOLD_PAYEE_ID=

# Force replay of the recorded Nessie cache even when a key IS present.
# Set to 1 before demo day so a dead sandbox cannot kill the run.
RECORDED=
