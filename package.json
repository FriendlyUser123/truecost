{
  "name": "ready",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.ts",
    "seed:nessie": "tsx --env-file=.env scripts/seed-nessie.ts",
    "seed:nessie:household": "tsx --env-file=.env scripts/seed-nessie.ts household",
    "reset": "tsx --env-file=.env scripts/reset.ts",
    "record:cache": "tsx --env-file=.env scripts/record-cache.ts",
    "export:hokieai": "tsx scripts/export-hokieai.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
